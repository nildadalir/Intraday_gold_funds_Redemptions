# SQL Server (required only when config.yaml db.use_db is true)
DB_SERVER=your_sql_server
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

# Optional HTTP proxy if the TSETMC CDN is not reachable directly
TSETMC_PROXY=

# SMTP (used only when config.yaml email.send is true)
EMAIL_HOST=your_smtp_server
EMAIL_USER=your_email@example.com
EMAIL_TO=recipient@example.com
EMAIL_CC=
