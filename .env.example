# Example environment file — copy to .env and fill in values.
# Never commit .env with real credentials.

# Iran-exit proxy for TSETMC (required when Cursor/global VPN blocks Iranian hosts)
# Examples:
#   TSETMC_PROXY=http://user:pass@iran-proxy.example:8080
#   TSETMC_PROXY=socks5://127.0.0.1:1080
TSETMC_PROXY=
